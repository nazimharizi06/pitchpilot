# Optional. Without this set, plan generation falls back to the deterministic
# mock AI provider (lib/ai/mockProvider.ts) and the app runs with zero setup.
# Set this to have plan generation use real Claude judgment (lib/ai/claudeProvider.ts)
# for goal-weighting and session explanations.
ANTHROPIC_API_KEY=

# Required for accounts + subscription gating (Supabase project settings).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Required for Stripe checkout/billing (test-mode keys from the Stripe dashboard).
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe` locally.
STRIPE_WEBHOOK_SECRET=
# Filled in after running `node scripts/stripe-setup.mjs` — see README.
STRIPE_PRICE_BASE=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PREMIUM=

# Used to build Stripe redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Without these set, product analytics (lib/analytics.ts) no-ops
# safely — nothing breaks, events are just never sent. From your PostHog
# project settings (Project API key / Host, e.g. https://us.i.posthog.com).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
